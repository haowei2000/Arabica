# =============================================================================
# Aiwen Application - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed
# This unified config works for: backend (src/), frontend/, and docker/
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
APP_NAME=Aiwen
DEBUG=false
ENV=production
TZ=Asia/Shanghai
RELOAD=false

# -----------------------------------------------------------------------------
# Docker Compose Settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=agent-chat
COMPOSE_PROFILES=infra
VERSION=latest

# -----------------------------------------------------------------------------
# Backend API Settings
# -----------------------------------------------------------------------------
AIWEN_APP_PORT=8000
EXPOSE_PORT_AIWEN_PY=8000
AIWEN_APP_HOST=0.0.0.0
APP_CACHE_ENABLED=true

# MCP Server Settings
AIWEN_MCP_PORT=9000
EXPOSE_PORT_AIWEN_MCP=9000
AIWEN_MCP_HOST=0.0.0.0
MCP_TRANSPORT=http
MCP_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend Settings (Vite)
# -----------------------------------------------------------------------------
FRONTEND_EXPOSE_PORT=3000
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Aiwen

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (with pgvector support)
# -----------------------------------------------------------------------------
# Docker expose port
EXPOSE_PORT_POSTGRES=5433

# Application connection (double underscore for nested config)
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USERNAME=postgres
POSTGRES__PASSWORD=wang20000520
POSTGRES__AIWEN_DBNAME=agent-chat
POSTGRES__DIFY_DBNAME=dify
POSTGRES__DRIVER=postgresql+asyncpg

# -----------------------------------------------------------------------------
# MySQL Configuration
# -----------------------------------------------------------------------------
# Docker expose port
EXPOSE_PORT_MYSQL=3306

# Application connection
MYSQL__HOST=localhost
MYSQL__PORT=3306
MYSQL__USERNAME=root
MYSQL_ROOT_PASSWORD=wang20000520
MYSQL__PASSWORD=aiwen123456
MYSQL__DBNAME=aiwen
MYSQL__DRIVER=mysql+asyncmy

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Docker expose port
EXPOSE_PORT_REDIS=6379

# Application connection
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__USERNAME=
REDIS__PASSWORD=wang20000520
REDIS__DB=1

# Redis Commander (optional admin UI)
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# JWT Settings
AUTH__JWT_SECRET_KEY=haowei
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin User
AUTH__ADMIN_USERNAME=admin
AUTH__ADMIN_PASSWORD=admin123
AUTH__ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Ollama (local LLM)
EXPOSE_PORT_OLLAMA=11434
OLLAMA__HOST=localhost
OLLAMA__PORT=11434
OLLAMA__PROTOCOL=http

# OpenAI Compatible API (e.g., Dashscope/Tongyi)
OPENAI__API_KEY=
OPENAI__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI__MODEL=qwen-plus

# Dashscope API Key (backward compatibility)
DASHSCOPE_API_KEY=

# -----------------------------------------------------------------------------
# Resource Limits (Docker)
# -----------------------------------------------------------------------------
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
MEMORY_LIMIT=4G
MEMORY_RESERVATION=1G
