# Optional HTTP server configuration. Add these to the ignored .env.local
# generated by `just dev-init`; keep its worktree-specific paths and port.
# CLI/ACP use $ARABICA_HOME/config.toml instead of these provider JSON values.
OPENAI_API_KEY=replace-me
ARABICA__PROVIDERS_JSON='{"openai":{"api_type":"open_ai_responses","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY"}}'
ARABICA__BLEND_MODELS_JSON='{"fast":{"provider":"openai","model_id":"replace-with-model-id"}}'
ARABICA__BLEND_DEFAULT=fast
ARABICA__COMPACTION_STRATEGY=file_backed_gc
COMPACTION_EFFORT=1
PGC_CONTINUATION_PROBABILITY_BPS=7500
