# =============================================
# AIWen Service - Environment Configuration
# =============================================

# Service Configuration
APP_NAME=AIWen Service
DEBUG=false
ENV=production

# Ports
AIWEN_PY_EXPOSE_PORT=8000
AIWEN_MCP_EXPOSE_PORT=9000
AIWEN_PY_PORT=8000
AIWEN_MCP_PORT=9000

# PostgreSQL Configuration
POSTGRES_EXPOSE_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aiwen123456
POSTGRES_AIWEN_DBNAME=aiwen
POSTGRES_DIFY_DBNAME=dify

# MySQL Configuration
MYSQL_EXPOSE_PORT=3306
MYSQL_PORT=3306
MYSQL_USER=aiwen
MYSQL_PASSWORD=aiwen123456
MYSQL_DBNAME=aiwen

# Redis Configuration
REDIS_EXPOSE_PORT=6379
REDIS_PORT=6379
REDIS_PASSWORD=aiwenredis123
REDIS_DB=1

# Ollama Configuration
OLLAMA_EXPOSE_PORT=11434
OLLAMA_PORT=11434

# Authentication
AUTH__JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH__REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH__ADMIN_USERNAME=admin
AUTH__ADMIN_PASSWORD=admin123

# External Services
DASHSCOPE_API_KEY=

# Redis Commander
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# Resource Limits
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
MEMORY_LIMIT=4G
MEMORY_RESERVATION=1G

# Reload (for development)
RELOAD=false