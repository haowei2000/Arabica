# =============================================================================
# Structure Application - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed
# This unified config works for: backend (src/), frontend/, and docker/
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
APP_NAME=Structure
DEBUG=false
ENV=production
TZ=Asia/Shanghai
RELOAD=false

# -----------------------------------------------------------------------------
# Public-facing scheme & domain
# -----------------------------------------------------------------------------
# Toggle whether the deployed site is served over HTTPS.  Where it takes effect:
#   - frontend build:  VITE_APP_URL is derived as ${scheme}://${STRUCTURE_DOMAIN}
#   - reverse proxy:   docker/nginx.frontend.conf can pick a 443+TLS server
#                      block when true (the default conf only listens on 80).
#   - backend cookies: set STRUCTURE_HTTPS_ENABLED=true to send Secure cookies
#                      and trust the X-Forwarded-Proto header from the proxy.
# Leave false for local dev (http://localhost:<EXPOSE_PORT_*>) and switch to
# true once a TLS terminator is in front of the stack (Cloudflare, Caddy,
# Let's Encrypt + nginx, etc.).
STRUCTURE_HTTPS_ENABLED=false
STRUCTURE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Docker Compose Settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=structure
COMPOSE_PROFILES=infra,app
VERSION=latest
PYTHON_VERSION=3.12
UV_VERSION=0.5.24

# -----------------------------------------------------------------------------
# Backend API Settings
# -----------------------------------------------------------------------------
# Host port exposed by Docker Compose for the backend API container.
EXPOSE_PORT_STRUCTURE_PY=8000

# Port used by `uv run structure-api` / `src/structure/api_cli.py`.
# In Docker this is fixed to 8000 inside the container.
STRUCTURE_APP_PORT=8000

# Enable FastAPI response cache middleware. The application settings model reads
# APP_CACHE_ENABLE; APP_CACHE_ENABLED is kept as a compatibility alias for older
# local env files and compose overrides.
APP_CACHE_ENABLE=true
APP_CACHE_ENABLED=true

# MCP Server Settings
EXPOSE_PORT_MCP=9090
STRUCTURE_MCP_PORT=9000
STRUCTURE_MCP_HOST=0.0.0.0
MCP_TRANSPORT=http
MCP_CACHE_ENABLE=true
MCP_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend Settings (Vite)
# -----------------------------------------------------------------------------
FRONTEND_EXPOSE_PORT=80

# API base URL for frontend code (relative path recommended)
VITE_API_BASE_URL=/api

# Backend host/port for Vite dev proxy target
# In development: defaults to 127.0.0.1:8000
# For LAN access: set to 0.0.0.0 or specific IP
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000
VITE_APP_TITLE=Structure
VITE_APP_URL=http://localhost

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (with pgvector support)
# -----------------------------------------------------------------------------
# Docker expose port
EXPOSE_PORT_POSTGRES=5432

# Application connection (double underscore for nested config)
POSTGRES__HOST=127.0.0.1
POSTGRES__PORT=5432
POSTGRES__USERNAME=postgres
POSTGRES__PASSWORD=change-me-postgres-password
POSTGRES__STRUCTURE_DBNAME=structure
POSTGRES__DRIVER=postgresql+asyncpg

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Docker expose port
EXPOSE_PORT_REDIS=6379
# Application connection
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__USERNAME=
REDIS__PASSWORD=change-me-redis-password
REDIS__DB=1

# Redis stream / queue names (optional, defaults shown)
# REDIS__WORKSPACE_LABEL=workspace
# REDIS__RUN_LABEL=run
# REDIS__EXECUTOR_LABEL=executor
# REDIS__STREAM_EVENTS_SUFFIX=events
# REDIS__CONSUMER_GROUP=run_workers
# REDIS__RUN_RESUME_APPROVAL_SUFFIX=resume_approval
# REDIS__EVENT_TYPE_KEEPALIVE=keepalive
# REDIS__EVENT_TYPE_ERROR=error
# REDIS__EVENT_TYPE_DISCONNECT=disconnect

# Redis Commander (optional admin UI)
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=change-me-redis-commander-password

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# JWT Settings
AUTH__JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH__ADMIN_EMAIL=admin@example.com
AUTH__REQUIRE_EMAIL_VERIFICATION=true

# Default Admin User
AUTH__ADMIN_USERNAME=admin
AUTH__ADMIN_PASSWORD=change-me-admin-password

# Email Verification
EMAIL__PROVIDER=brevo
EMAIL__BREVO_API_KEY=
EMAIL__FROM_NAME=Structure
EMAIL__FROM_EMAIL=noreply@example.com
EMAIL__APP_BASE_URL=http://localhost
EMAIL__VERIFY_EMAIL_ON_REGISTER=true
EMAIL__VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# User Quota
QUOTA__ENABLED=true
QUOTA__FREE_TOKENS_PER_USER=100000
QUOTA__SUPERUSER_BYPASS=true

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# LLM API keys and model settings are managed via the UI (LLM Models settings page).
# Set OPENAI__API_KEY in real environments only; never commit a real key.
OPENAI__API_KEY=
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__MODEL=gpt-4.1-mini
OPENAI__EMBEDDING_MODEL=text-embedding-3-small
OPENAI__EMBEDDING_DIMENSION=1536
EXPOSE_PORT_OLLAMA=11434
OLLAMA__HOST=127.0.0.1
OLLAMA__PORT=11434
OLLAMA__PROTOCOL=http

# DashScope-compatible clients read this top-level key from AppSettings.
# Leave empty unless you use Alibaba Tongyi/DashScope integrations.
DASHSCOPE_API_KEY=

# -----------------------------------------------------------------------------
# RustFS Configuration (S3-compatible storage)
# -----------------------------------------------------------------------------
RUSTFS_EXPOSE_API=9000
RUSTFS_EXPOSE_CONSOLE=9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS__ACCESS_KEY=change-me-rustfs-access-key
RUSTFS__SECRET_KEY=change-me-rustfs-secret-key
RUSTFS__HOST=127.0.0.1
RUSTFS__PORT=9000
RUSTFS__SECURE=false
RUSTFS__BUCKET=knowledge

# -----------------------------------------------------------------------------
# Backend Process Settings
# -----------------------------------------------------------------------------
# Run event worker as an asyncio background task inside the API process.
# Set to false to run structure-worker as a separate process (higher memory).
EMBED_WORKER=true

# File-based context storage directory (used when context-service is embedded).
CONTEXT_SERVICE_DATA_ROOT=/app/data/context

# Workspace context service cache. These affect in-process context service reuse,
# not Redis or LLM KV-cache behavior.
WORKSPACE_CONTEXT_CACHE_SIZE=200
WORKSPACE_CONTEXT_CACHE_TTL=300

# Limit glibc malloc arena count to reduce Python memory fragmentation.
MALLOC_ARENA_MAX=2

# -----------------------------------------------------------------------------
# Test and Benchmark Settings
# -----------------------------------------------------------------------------
# Optional PostgreSQL URL for tests marked `integration`.
# Required only when running:
#   uv run pytest tests/integration --run-integration
# Leave empty to let integration tests derive a URL from POSTGRES__* values and
# skip cleanly if the local database is unavailable.
# Example:
# STRUCTURE_INTEGRATION_DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5432/structure_test
STRUCTURE_INTEGRATION_DATABASE_URL=

# Optional OpenAI-compatible settings for live benchmark smoke tests.
# Fixture-based benchmark integration tests do not require these.
# Required only for:
#   uv run python -m benchmarks.scripts.run_llm_benchmark ...
BENCHMARK_LLM_API_KEY=
BENCHMARK_LLM_BASE_URL=https://api.openai.com/v1
BENCHMARK_LLM_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# Optional Services
# -----------------------------------------------------------------------------
FLOWER_PORT=5555
