[Unit]
Description=Structure Agent Worker
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=structure
Group=structure
WorkingDirectory=/opt/structure
Environment=PYTHONPATH=/opt/structure
Environment=ENV_FILE=/opt/structure/.env
ExecStart=/opt/structure/.venv/bin/python -m src.structure.workers
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target