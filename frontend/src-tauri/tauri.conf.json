{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Structure",
  "version": "5.5.0",
  "identifier": "ai.structure.local",
  "build": {
    "frontendDist": "local-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Structure",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../public/icon.png"]
  }
}
