# =============================================================================
# Structure — Performance Tuning Knobs
# =============================================================================
# Loaded as a *second* `--env-file` after `.env` (later files override earlier
# ones in Docker Compose v2). Only put non-secret tunables here; keep .env for
# credentials / connection info.
#
# Apply via:
#   docker compose -p structure -f docker/docker-compose.yml \
#     --env-file .env --env-file performance.env up -d
#
# `make docker-up` and `.github/workflows/cd.yml` already chain both files.
#
# -----------------------------------------------------------------------------
# Sizing recommendations by host RAM
# -----------------------------------------------------------------------------
# 4 GB host (default values below):
#   • Add 2 GB swap: fallocate -l 2G /swapfile && mkswap /swapfile && swapon /swapfile
#   • Total committed limits ≈ 2.9 GB; leaves ~0.4 GB for OS + Docker
#
# 8 GB host (uncomment "8GB profile" lines, comment defaults):
#   • BACKEND_MEMORY_LIMIT=2G, POSTGRES_MEMORY_LIMIT=1G,
#     POSTGRES_SHARED_BUFFERS=512MB, REDIS_MAXMEMORY=512mb,
#     REDIS_MEMORY_LIMIT=640M
#
# 16 GB+ host:
#   • BACKEND_MEMORY_LIMIT=4G, POSTGRES_MEMORY_LIMIT=2G,
#     POSTGRES_SHARED_BUFFERS=2GB, POSTGRES_EFFECTIVE_CACHE_SIZE=8GB,
#     REDIS_MAXMEMORY=1gb, REDIS_MEMORY_LIMIT=1280M
# =============================================================================


# -----------------------------------------------------------------------------
# Backend (FastAPI + executor + worker)
# -----------------------------------------------------------------------------
# Raise if you do heavy embedding / langchain work. Don't go above 70% of
# physical RAM minus other services' limits.
BACKEND_MEMORY_LIMIT=1400M
BACKEND_MEMORY_RESERVATION=512M


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# - shared_buffers: how much RAM Postgres uses as its own cache (~25% of
#   POSTGRES_MEMORY_LIMIT is a safe target).
# - effective_cache_size: hint to query planner about total cache (does NOT
#   allocate); set to 1.5–3x shared_buffers, can safely be very large.
# - work_mem: per sort/hash op; multiplied by concurrent queries × steps so
#   raise carefully.
# - maintenance_work_mem: VACUUM, CREATE INDEX. Bump for fast index builds
#   (especially pgvector HNSW).
# - max_connections: total client cap; each connection costs ~3–10 MB.
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_MEMORY_RESERVATION=256M
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_MAX_CONNECTIONS=100


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_MEMORY_LIMIT must exceed REDIS_MAXMEMORY by at least the size of one
# RDB fork (≈maxmemory worth of COW headroom). 320M ⇄ 256mb is the safe
# small-host pairing.
REDIS_MEMORY_LIMIT=320M
REDIS_MEMORY_RESERVATION=128M
REDIS_MAXMEMORY=256mb


# -----------------------------------------------------------------------------
# Auxiliaries — these typically stay at low caps; bump only if you observe OOM
# in their logs.
# -----------------------------------------------------------------------------
CELERY_BEAT_MEMORY_LIMIT=128M
CELERY_BEAT_MEMORY_RESERVATION=64M

FLOWER_MEMORY_LIMIT=128M
FLOWER_MEMORY_RESERVATION=64M

FRONTEND_MEMORY_LIMIT=128M
FRONTEND_MEMORY_RESERVATION=32M

REDIS_COMMANDER_MEMORY_LIMIT=96M
REDIS_COMMANDER_MEMORY_RESERVATION=32M
