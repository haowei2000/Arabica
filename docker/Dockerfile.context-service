FROM docker.m.daocloud.io/library/python:3.12-slim

# Install 'file' utility
RUN apt-get update && apt-get install -y --no-install-recommends \
    file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY pyproject.toml .
# We only need fastapi and uvicorn for this small service
RUN pip install fastapi uvicorn pydantic

# Copy source code
COPY src/structure/services/context_service /app/context_service

# Create data directory
RUN mkdir -p /app/data/context && chmod 777 /app/data/context

EXPOSE 8080

CMD ["uvicorn", "context_service.main:app", "--host", "0.0.0.0", "--port", "8080"]
